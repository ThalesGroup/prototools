#!/usr/bin/env python3
"""Differential harness for the Rust port of reproto (spec 0424 S11, S12).

Runs a reference and a candidate command on the same cases, each in an
empty directory, and compares what they produce, byte for byte: every
file they write, stdout, stderr and the exit status.

Usage:
  scripts/protoback-harness prepare WORK [--googleapis PB] [--otel DIR]
  scripts/protoback-harness run WORK --reference CMD --candidate CMD
                                [--jobs N] [--only REGEX] [--rename OLD=NEW]...
                                [--dump-graph | --compare PATH...]

`prepare` builds the corpora under WORK/corpus with protoc; `run` runs
every case on them and writes WORK/report.txt. CMD is a command line,
split as a shell would (`reproto`, `python -m reproto.cli`, `protoback`).
`run` exits 1 if any case differs.

Normalized before comparison, the only differences allowed (S12):
  - the run directory's own path, in stdout and stderr;
  - with --rename OLD=NEW, the reference's program name OLD, read as NEW.

With --dump-graph (spec 0428 S10), each case runs with
`--dump-graph=graph.txt` added: both tools stop after phase 6 and write
the graph dump. The exit status and the files written are compared, the
dump's first differing line reported; stdout and stderr are not, since
printing warnings as reproto does is step 9 (spec 0428 N2), and the dump
holds what was warned about.

With --compare PATH... (spec 0429 S2), only the exit status and the files
written under those run-directory paths are compared, each differing
.proto file reported by its first differing line; stdout and stderr are
not compared, as with --dump-graph.
"""

from __future__ import annotations

import argparse
import concurrent.futures
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
FIXTURES = REPO / "reproto/src/reproto/tests/fixtures"
WKT_SOURCES = REPO / "prototext/wkt/SOURCES"
ANOMALIES = REPO / "tests/fixtures/anomalies.pb"

# The flag sets every fixture runs with: the options that change the
# output (S11). A case without a --builtin of its own gets the
# embedded descriptor.proto, as the test suite does: without it, reproto
# stops on any input that does not include descriptor.proto.
FLAG_SETS: dict[str, list[str]] = {
    "default": [],
    "all-builtin": ["--builtin", "all"],
    "force-proto2-output": ["--force-proto2-output"],
    "force-proto2-for-editions": ["--force-proto2-for-editions"],
    "schema-db": ["--emit-binary", "--emit-scoring-yaml",
                  "--emit-extension-ranges", "--schema-db-out=out/db.desc"],
    # The descriptors beside the text (spec 0429 S10).
    "emit-binary": ["--emit-binary"],
    "emit-binary-force-proto2-output": ["--emit-binary", "--force-proto2-output"],
    # The scoring graphs beside the text (spec 0430 S3), with extension
    # ranges, and under --dry-run, where reproto's pool loads each file
    # only as its graph is collected (S1).
    "scoring-yaml": ["--emit-scoring-yaml"],
    "scoring-yaml-extension-ranges": ["--emit-scoring-yaml", "--emit-extension-ranges"],
    "scoring-yaml-dry-run": ["--emit-scoring-yaml", "--emit-extension-ranges", "--dry-run"],
    # The schema database's graph drawn (spec 0430 S8): raw and minimized,
    # with the leaves, with a --hide pattern, and with one reproto refuses.
    "scoring-html": ["--schema-db-out=out/db.desc", "--scoring-html-out=out/graph.html"],
    "scoring-html-leaves": ["--schema-db-out=out/db.desc", "--scoring-html-out=out/graph.html",
                            "--with-leaf-nodes"],
    "scoring-html-hide": ["--schema-db-out=out/db.desc", "--scoring-html-out=out/graph.html",
                          "--hide", "desc:**.Field*"],
    "scoring-html-bad-hide": ["--schema-db-out=out/db.desc", "--scoring-html-out=out/graph.html",
                              "--hide", "google.*"],
}
DEFAULT_BUILTIN = ["--builtin", "descriptor"]

# googleapisDb's flags (nix/python.nix), and customDb's.
GOOGLEAPIS_FLAGS = ["--builtin", "all", "--force-proto2-for-editions",
                    "--emit-scoring-yaml", "--emit-binary",
                    "--schema-db-out=out/googleapis.desc"]
CUSTOM_FLAGS = ["--builtin", "all", "--force-proto2-for-editions",
                "--emit-scoring-yaml", "--schema-db-out=out/custom.desc"]


# ── prepare ──────────────────────────────────────────────────────────────────

def protoc(*args: str | Path, stdin: bytes | None = None) -> bytes | None:
    """Run protoc; its stdout, or None if it fails."""
    r = subprocess.run(["protoc", *map(str, args)], input=stdin,
                       capture_output=True)
    return r.stdout if r.returncode == 0 else None


def varint(data: bytes, i: int) -> tuple[int, int]:
    """A varint at data[i]: its value, and where it ends."""
    v, shift = 0, 0
    while True:
        b = data[i]
        v |= (b & 0x7F) << shift
        i += 1
        if b < 0x80:
            return v, i
        shift += 7


def put_varint(v: int) -> bytes:
    out = bytearray()
    while v >= 0x80:
        out.append((v & 0x7F) | 0x80)
        v >>= 7
    out.append(v)
    return bytes(out)


def drop_dependencies(fds: bytes) -> bytes:
    """A FileDescriptorSet with every file's `dependency` (field 3) entries
    dropped, on the wire: what protoc's text round trip cannot do, an
    option of an undeclared extension being an unknown field to it."""
    def records(data: bytes):
        i = 0
        while i < len(data):
            start = i
            key, i = varint(data, i)
            wire = key & 7
            if wire == 0:
                _, i = varint(data, i)
            elif wire == 2:
                n, i = varint(data, i)
                i += n
            elif wire == 1:
                i += 8
            elif wire == 5:
                i += 4
            else:
                raise ValueError(f"wire type {wire}")
            yield key >> 3, wire, data[start:i]

    out = bytearray()
    for number, wire, rec in records(fds):
        if number != 1 or wire != 2:
            out += rec
            continue
        _, body_at = varint(rec, 0)
        _, body_at = varint(rec, body_at)
        body = b"".join(r for n, _, r in records(rec[body_at:]) if n != 3)
        out += put_varint((1 << 3) | 2) + put_varint(len(body)) + body
    return bytes(out)


def to_text(pb: Path, out: Path) -> None:
    """A descriptor set in text format, as protoc --decode prints it."""
    text = protoc("--decode=google.protobuf.FileDescriptorSet",
                  "google/protobuf/descriptor.proto", stdin=pb.read_bytes())
    if text is not None:
        out.write_bytes(text)


def prepare(work: Path, googleapis: Path | None, otel: Path | None) -> None:
    if otel is not None and not (otel / "opentelemetry").is_dir():
        sys.exit(f"protoback-harness: --otel {otel} is not opentelemetry-proto")
    if googleapis is not None and not googleapis.is_file():
        sys.exit(f"protoback-harness: --googleapis {googleapis} is not a file")
    corpus = work / "corpus"
    if corpus.exists():
        shutil.rmtree(corpus)
    fixtures = sorted(FIXTURES.glob("*.proto"))

    # Each fixture alone (its imports missing), with its imports, and with
    # its imports and their source info (the comments reproto renders,
    # spec 0429 S9), in a directory of its own: -I gives reproto that
    # directory and no more.
    for p in fixtures:
        for kind, extra in (("alone", []), ("imports", ["--include_imports"]),
                            ("sourceinfo", ["--include_imports", "--include_source_info"])):
            d = corpus / kind / p.stem
            d.mkdir(parents=True)
            if protoc(f"-I{FIXTURES}", *extra,
                      f"--descriptor_set_out={d / (p.stem + '.pb')}", p) is None:
                shutil.rmtree(d)

    # The well-known types, as wktRkyv compiles them.
    wkt = corpus / "wkt"
    wkt.mkdir()
    sources = [s for s in WKT_SOURCES.read_text().split("\n") if s]
    assert protoc("--include_imports",
                  f"--descriptor_set_out={wkt / 'wkt.desc'}", *sources) is not None

    # Text format: the fixtures with their imports, and the WKT (S11 6).
    text = corpus / "text"
    for d in sorted((corpus / "imports").iterdir()):
        (text / d.name).mkdir(parents=True)
        to_text(d / f"{d.name}.pb", text / d.name / f"{d.name}.textpb")
    (text / "wkt").mkdir()
    to_text(wkt / "wkt.desc", text / "wkt" / "wkt.textpb")

    # A blob: descriptors embedded among other bytes, as in a binary.
    blob = corpus / "blob"
    blob.mkdir()
    parts = [bytes(range(256)) * 4]
    for name in ("address_book", "enum", "service"):
        parts += [(corpus / "imports" / name / f"{name}.pb").read_bytes(),
                  b"\x00\xff" * 512]
    (blob / "blob.bin").write_bytes(b"".join(parts))

    # Two files defining the same message, each compiled alone: phase 2
    # prunes the second (W3), unless --keep-duplicates.
    dup = corpus / "duplicates"
    (dup / "src").mkdir(parents=True)
    for name in ("dup_one", "dup_two"):
        (dup / "src" / f"{name}.proto").write_text(
            'syntax = "proto2";\npackage dup;\nmessage Same {}\n')
        assert protoc(f"-I{dup / 'src'}", f"--descriptor_set_out={dup / name}.pb",
                      f"{name}.proto") is not None

    # The order files render in decides nothing (spec 0429 S14):
    # ord_use.proto sets ord.tag, declared in ord_ext.proto, its import
    # dropped. Rendered after ord_ext (1_ext.pb before 2_use.pb) or before
    # it, the option is an orphan, with W22: outside the file's closure.
    order = corpus / "order"
    (order / "src").mkdir(parents=True)
    (order / "src" / "ord_ext.proto").write_text(
        'syntax = "proto2";\npackage ord;\nimport "google/protobuf/descriptor.proto";\n'
        'extend google.protobuf.FileOptions { optional string tag = 50101; }\n')
    (order / "src" / "ord_use.proto").write_text(
        'syntax = "proto2";\npackage ord;\nimport "ord_ext.proto";\n'
        'option (ord.tag) = "set";\nmessage M {}\n')
    ext, use = order / "src" / "ext.pb", order / "src" / "use.pb"
    assert protoc(f"-I{order / 'src'}", "--include_imports", f"--descriptor_set_out={ext}",
                  "ord_ext.proto") is not None
    assert protoc(f"-I{order / 'src'}", f"--descriptor_set_out={use}",
                  "ord_use.proto") is not None
    use.write_bytes(drop_dependencies(use.read_bytes()))
    for name, first, second in (("ext-first", ext, use), ("use-first", use, ext)):
        (order / name).mkdir()
        shutil.copy(first, order / name / f"1_{first.stem}.pb")
        shutil.copy(second, order / name / f"2_{second.stem}.pb")

    # The demos' anomalies set.
    demo = corpus / "demo"
    demo.mkdir()
    shutil.copy(ANOMALIES, demo / "anomalies.pb")

    # customDb's inputs: some fixtures and opentelemetry-proto, one file each.
    if otel is not None:
        custom = corpus / "custom"
        custom.mkdir()
        for name in ("field_comprehensive", "default_values_proto2",
                     "group_proto2", "extensions_proto2", "message_comprehensive",
                     "packed_proto3", "phone_number", "address_book",
                     "editions_rendering"):
            shutil.copy(corpus / "alone" / name / f"{name}.pb", custom)
        for p in sorted(otel.rglob("*.proto")):
            rel = p.relative_to(otel)
            flat = str(rel.with_suffix("")).replace("/", "_")
            protoc(f"--proto_path={otel}",
                   f"--descriptor_set_out={custom / (flat + '.pb')}", rel)

    if googleapis is not None:
        (corpus / "googleapis").mkdir()
        shutil.copy(googleapis, corpus / "googleapis" / "googleapis.pb")

    print(f"corpus prepared in {corpus}")


# ── cases ────────────────────────────────────────────────────────────────────

# The reference's words the candidate says otherwise on purpose (spec 0424
# S12): protoback's --phase2-plugin warning says what ctx is (spec 0431 S3).
NORMALIZE: list[tuple[bytes, bytes]] = [
    (b"Warning [W18]: --phase2-plugin is deprecated; use --fdp-plugin\n",
     b"Warning [W18]: --phase2-plugin is deprecated; use --fdp-plugin "
     b"(protoback calls phase2_plugin(ctx, fdp) with ctx None)\n"),
]


@dataclass
class Case:
    name: str
    args: list[str]
    # "reproto", or "instantiate": reproto-instantiate-schema against
    # protoback instantiate (spec 0432).
    tool: str = "reproto"


def _varint(b: bytes, i: int) -> tuple[int, int]:
    n, shift = 0, 0
    while True:
        c = b[i]
        i += 1
        n |= (c & 0x7F) << shift
        if not c & 0x80:
            return n, i
        shift += 7


def _fields(b: bytes) -> list[tuple[int, int, bytes | int]]:
    """A message's records: (number, wire type, bytes or integer)."""
    out, i = [], 0
    while i < len(b):
        tag, i = _varint(b, i)
        number, wt = tag >> 3, tag & 7
        if wt == 0:
            v, i = _varint(b, i)
            out.append((number, wt, v))
        elif wt == 2:
            n, i = _varint(b, i)
            out.append((number, wt, b[i:i + n]))
            i += n
        elif wt == 1:
            i += 8
        elif wt == 5:
            i += 4
        else:
            raise ValueError(f"wire type {wt} in a descriptor")
    return out


def message_types(desc: Path) -> list[str]:
    """The message types of a FileDescriptorSet, map entries left out, in
    file and declaration order: read from the wire, without protobuf. Only
    the files that load: their imports in the set, transitively, or
    descriptor.proto, which both generators supply when the set lacks it."""
    def walk(prefix: str, msg: bytes, out: list[str]) -> None:
        recs = _fields(msg)
        name = next(v.decode() for n, _, v in recs if n == 1 and isinstance(v, bytes))
        fqdn = prefix + name
        map_entry = any(n == 7 and wt == 0 and v for o_n, o_wt, o in recs
                        if o_n == 7 and isinstance(o, bytes)
                        for n, wt, v in _fields(o))
        if not map_entry:
            out.append(fqdn)
        for n, _, v in recs:
            if n == 3 and isinstance(v, bytes):
                walk(fqdn + ".", v, out)
    out: list[str] = []
    loaded = {"google/protobuf/descriptor.proto"}
    for n, _, f in _fields(desc.read_bytes()):
        if n != 1 or not isinstance(f, bytes):
            continue
        recs = _fields(f)
        name = next((v.decode() for n2, _, v in recs
                     if n2 == 1 and isinstance(v, bytes)), "")
        deps = [v.decode() for n2, _, v in recs if n2 == 3 and isinstance(v, bytes)]
        if not all(d in loaded for d in deps):
            continue
        loaded.add(name)
        package = next((v.decode() for n2, _, v in recs
                        if n2 == 2 and isinstance(v, bytes)), "")
        for n2, _, m in recs:
            if n2 == 4 and isinstance(m, bytes):
                walk(f"{package}." if package else "", m, out)
    return out


# The plugins of the plugin cases (spec 0431), written into the corpus.
PLUGINS: dict[str, str] = {
    "add_field.py": """\
def fdp_plugin(fdp):
    if fdp.name != 'plugin_subject.proto':
        return
    fdp.dependency.append('plugin_target.proto')
    field = fdp.message_type[0].field.add()
    field.name = 'target'
    field.number = 99
    field.label = field.LABEL_OPTIONAL
    field.type = field.TYPE_MESSAGE
    field.type_name = '.plugin_test.Target'
""",
    "add_field_phase2.py": """\
def phase2_plugin(ctx, fdp):
    if fdp.name != 'plugin_subject.proto':
        return
    fdp.dependency.append('plugin_target.proto')
""",
    "raises.py": """\
def fdp_plugin(fdp):
    if fdp.name == 'plugin_subject.proto':
        raise ValueError('refused')
""",
    "no_entry_point.py": "x = 1\n",
    "rename_package.py": """\
def fdp_plugin(fdp):
    if fdp.package:
        fdp.package = fdp.package + '.renamed'
""",
}


def cases(corpus: Path) -> list[Case]:
    out: list[Case] = []
    proto_out = ["--proto-out=out/proto"]

    for d in sorted((corpus / "imports").iterdir()):
        for flag_name, flags in FLAG_SETS.items():
            out.append(Case(f"imports/{d.name}/{flag_name}",
                            ["-I", str(d), *proto_out, *flags, f"{d.name}.pb"]))
    # --dump-resolved-features (spec 0433 G4): every fixture's file, and one
    # not loaded.
    for d in sorted((corpus / "imports").iterdir()):
        out.append(Case(f"imports/{d.name}/dump-resolved-features",
                        ["-I", str(d), "--dump-resolved-features", f"{d.name}.proto",
                         f"{d.name}.pb"]))
    out.append(Case("dump-resolved-features/not-loaded",
                    ["-I", str(corpus / "imports" / "address_book"),
                     "--dump-resolved-features", "no_such.proto", "address_book.pb"]))
    for d in sorted((corpus / "alone").iterdir()):
        out.append(Case(f"alone/{d.name}/default",
                        ["-I", str(d), *proto_out, f"{d.name}.pb"]))
    for d in sorted((corpus / "sourceinfo").iterdir()):
        for name, flags in (("default", []),
                            ("redact", ["--redact-comments", "--redact-orphans"]),
                            # The SourceCodeInfo synthesized from the text,
                            # with comments, redacted, and left out.
                            ("emit-binary", ["--emit-binary"]),
                            ("emit-binary-redact", ["--emit-binary", "--redact-comments",
                                                    "--redact-orphans"]),
                            ("emit-binary-no-source-info", ["--emit-binary",
                                                            "--no-source-info"])):
            out.append(Case(f"sourceinfo/{d.name}/{name}",
                            ["-I", str(d), *proto_out, *flags, f"{d.name}.pb"]))
    for d in sorted((corpus / "text").iterdir()):
        out.append(Case(f"text/{d.name}/default",
                        ["-I", str(d), *proto_out, f"{d.name}.textpb"]))

    wkt = corpus / "wkt"
    out.append(Case("wkt/default", ["-I", str(wkt), *proto_out, "wkt.desc"]))
    # wktRkyv's flags: what prototext/wkt/prebuilt is built with.
    out.append(Case("wkt/wkt-rkyv", ["-I", str(wkt), "--schema-db-out=out/wkt-db.desc",
                                     "--emit-extension-ranges",
                                     "-O", "out/wkt-db/proto", "wkt.desc"]))

    # Spec 0155 G1: -O inside the --schema-db-out stub, only as its 'proto'
    # child; and a run that loads nothing stops after phase 1, before
    # descriptor.proto is looked for (spec 0433 stage 6).
    ab_dir = corpus / "imports" / "address_book"
    for name, o in (("proto-child", "out/s/proto"), ("stub", "out/s"),
                    ("other-child", "out/s/desc"), ("nested-proto", "out/s/n/proto"),
                    ("outside", "out/elsewhere")):
        out.append(Case(f"stub-dir/{name}", ["-I", str(ab_dir), "--builtin", "descriptor",
                                             "--schema-db-out=out/s.desc", f"-O{o}",
                                             "address_book.pb"]))
    for name, flags in (("plain", []), ("builtin", ["--builtin", "descriptor"]),
                        ("use-variant", ["--use-variant", "descriptor"])):
        out.append(Case(f"nothing-loaded/{name}", [*flags, "-O", "out/o", "missing.pb"]))

    # Seeds and prunes on one set with imports.
    ab = corpus / "imports" / "address_book"
    for name, flags in (
        ("seed-desc", ["--seed", "desc:tutorial.Person"]),
        ("prune-file", ["--prune", "file:google/protobuf/timestamp.proto"]),
        ("prune-glob", ["--prune", "desc:tutorial.*"]),
        # Phases 4 and 5's messages: a near miss and its suggestion, a
        # glob matching nothing (no suggestion), a pruned seed.
        ("seed-near-miss", ["--seed", "desc:tutorial.Persn"]),
        ("prune-near-miss", ["--prune", "desc:tutorial.Persn"]),
        ("seed-glob-none", ["--seed", "desc:nowhere.*"]),
        ("seed-pruned", ["--seed", "desc:tutorial.Person", "--prune", "desc:tutorial.Person"]),
        # A message and one of its fields, both named.
        ("prune-with-child", ["--prune", "desc:tutorial.Person",
                              "--prune", "fdsc:tutorial.Person.id"]),
        ("seed-glob", ["--seed", "desc:tutorial.*"]),
        # Path seeds: the files they match, then pruned.
        ("seed-path", ["--seed", "*"]),
        ("seed-path-pruned", ["--seed", "*", "--prune", "file:address_book.proto"]),
        ("debug-fqdn", ["--seed", "desc:tutorial.Person", "--debug-fqdn"]),
    ):
        out.append(Case(f"patterns/address_book/{name}",
                        ["-I", str(ab), *proto_out, *flags, "address_book.pb"]))

    # Summoning (spec 0046) under a seed or prune, as test_summoning.py
    # runs it: each set's top file, its imports included.
    for top, flags in (
        ("tc1_a", ["--seed", "desc:.tc1.TA"]),
        ("tc2_a", ["--seed", "desc:.tc2.TA"]),
        ("tc3_a", ["--seed", "desc:.tc3.TA"]),
        ("tc4_user", ["--seed", "desc:.tc4.Leaf"]),
        ("bridge_lex_a", ["--seed", "desc:.bridgelex.LexA"]),
        ("tc6_a", ["--seed", "desc:.tc6.TA"]),
        ("tc7_u", ["--seed", "desc:.tc7.TS"]),
        ("tc8_q", ["--prune", "file:tc8_p.proto"]),
    ):
        d = corpus / "imports" / top
        out.append(Case(f"summoning/{top}",
                        ["-I", str(d), *proto_out, *flags, f"{top}.pb"]))

    # The collector's warnings printed at once: W3 for a duplicate, W7
    # for one file under two roots (binary and text).
    dup = corpus / "duplicates"
    for name, flags in (("default", []), ("keep", ["--keep-duplicates"])):
        out.append(Case(f"duplicates/{name}",
                        ["-I", str(dup), *proto_out, *flags, "dup_one.pb", "dup_two.pb"]))
    out.append(Case("shadowed/default",
                    ["-I", str(corpus / "imports" / "address_book"),
                     "-I", str(corpus / "text" / "address_book"), *proto_out]))

    for name in ("ext-first", "use-first"):
        out.append(Case(f"order/{name}", ["-I", str(corpus / "order" / name), *proto_out]))

    blob = corpus / "blob" / "blob.bin"
    out.append(Case("blob/default", ["-I", str(blob), *proto_out]))

    # Instances (spec 0432): every WKT type, also with other options; every
    # type of each custom fixture; 400 of googleapis', evenly spaced; an
    # unknown type, and no descriptor.
    inst_out = ["-O", "out/instances", "-q"]
    wkt = corpus / "wkt" / "wkt.desc"
    wkt_types = message_types(wkt)
    out.append(Case("instances/wkt", ["--descriptor-set", str(wkt), *inst_out,
                                      *wkt_types], "instantiate"))
    out.append(Case("instances/wkt-options",
                    ["--descriptor-set", str(wkt), *inst_out, "--seed", "7",
                     "--max-depth", "6", "--max-repeated", "5", *wkt_types],
                    "instantiate"))
    out.append(Case("instances/unknown-type",
                    ["--descriptor-set", str(wkt), *inst_out, "no.Such"], "instantiate"))
    out.append(Case("instances/no-descriptor", [*inst_out, "google.protobuf.Any"],
                    "instantiate"))
    if (corpus / "custom").is_dir():
        for pb in sorted((corpus / "custom").glob("*.pb")):
            # A fixture whose files all need imports it does not hold has
            # nothing to instantiate.
            if types := message_types(pb):
                out.append(Case(f"instances/custom/{pb.stem}",
                                ["--descriptor-set", str(pb), *inst_out, *types],
                                "instantiate"))
    googleapis = corpus / "googleapis" / "googleapis.pb"
    if googleapis.is_file():
        types = message_types(googleapis)
        sample = [types[i * len(types) // 400] for i in range(400)]
        out.append(Case("instances/googleapis",
                        ["--descriptor-set", str(googleapis), *inst_out, *sample],
                        "instantiate"))

    # Plugins (spec 0431): reproto's own test plugin, which adds an import
    # and a field typed by it; the same through the deprecated
    # --phase2-plugin; one that raises; one over text input. The plugin
    # files are written here, so a corpus prepared before them works.
    plugins = corpus / "plugins"
    plugins.mkdir(exist_ok=True)
    for name, source in PLUGINS.items():
        path = plugins / name
        if not path.exists() or path.read_text() != source:
            path.write_text(source)
    subject = ["-I", str(corpus / "imports" / "plugin_subject"),
               "-I", str(corpus / "imports" / "plugin_target"), *proto_out]
    for name, flags in (
        ("add-field", ["--fdp-plugin", str(plugins / "add_field.py")]),
        ("add-field-binary", ["--fdp-plugin", str(plugins / "add_field.py"),
                              "--emit-binary"]),
        ("phase2", ["--phase2-plugin", str(plugins / "add_field_phase2.py")]),
        ("raises", ["--fdp-plugin", str(plugins / "raises.py")]),
        ("no-entry-point", ["--fdp-plugin", str(plugins / "no_entry_point.py")]),
    ):
        out.append(Case(f"plugins/{name}", [*subject, *flags, "plugin_subject.pb"]))
    out.append(Case("plugins/text", ["-I", str(corpus / "text" / "address_book"),
                                     *proto_out, "--fdp-plugin",
                                     str(plugins / "rename_package.py")]))

    demo = corpus / "demo"
    for flag_name in ("default", "schema-db"):
        out.append(Case(f"demo/anomalies/{flag_name}",
                        ["-I", str(demo), *proto_out, *FLAG_SETS[flag_name],
                         "anomalies.pb"]))

    if (corpus / "custom").is_dir():
        out.append(Case("custom/custom-db", ["-I", str(corpus / "custom"),
                                             "--proto-out=out/custom/proto",
                                             *CUSTOM_FLAGS, "."]))
        # A graph of more than 100 nodes: pyvis's page with its loading bar
        # (spec 0430 S8).
        out.append(Case("custom/custom-db-html", ["-I", str(corpus / "custom"),
                                                  "--proto-out=out/custom/proto",
                                                  *CUSTOM_FLAGS,
                                                  "--scoring-html-out=out/graph.html",
                                                  "--with-leaf-nodes", "."]))
    if (corpus / "googleapis").is_dir():
        out.append(Case("googleapis/googleapis-db",
                        ["-I", str(corpus / "googleapis"),
                         "--proto-out=out/googleapis/proto", *GOOGLEAPIS_FLAGS,
                         "googleapis.pb"]))
    for case in out:
        if case.tool == "reproto" and not {"--builtin", "--use-variant"} & set(case.args):
            case.args[:0] = DEFAULT_BUILTIN
    return out


# ── run ──────────────────────────────────────────────────────────────────────

ENV_DROP = ("REPROTO_VARIANT", "PROTOTEXT_DESCRIPTOR_SET",
            "PROTOTEXT_DEFAULT_DESCRIPTOR")


@dataclass
class Run:
    stdout: bytes
    stderr: bytes
    exit: int
    seconds: float


DUMP = "graph.txt"


@dataclass(frozen=True)
class Mode:
    """What a run compares. By default everything: the exit status, stdout,
    stderr and every file written. --dump-graph adds the option and
    compares the dump; --compare restricts the files to some paths. Either
    leaves out stdout and stderr (spec 0428 S10, spec 0429 S2)."""
    dump_graph: bool = False
    compare: tuple[str, ...] = ()

    @property
    def streams(self) -> bool:
        return not self.dump_graph and not self.compare

    def selected(self, rel: str) -> bool:
        return not self.compare or any(
            rel == p or rel.startswith(p.rstrip("/") + "/") for p in self.compare)

    def label(self) -> str:
        if self.dump_graph:
            return "graph dumps (--dump-graph), "
        if self.compare:
            return f"files under {', '.join(self.compare)} (--compare), "
        return ""


def run_side(cmd: list[str], case: Case, rundir: Path, mode: Mode) -> Run:
    if rundir.exists():
        shutil.rmtree(rundir)
    rundir.mkdir(parents=True)
    env = {k: v for k, v in os.environ.items() if k not in ENV_DROP}
    extra = [f"--dump-graph={DUMP}"] if mode.dump_graph else []
    start = time.monotonic()
    r = subprocess.run([*cmd, *case.args, *extra], cwd=rundir, env=env,
                       capture_output=True)
    seconds = time.monotonic() - start
    placeholder = b"<RUN>"
    return Run(r.stdout.replace(bytes(rundir), placeholder),
               r.stderr.replace(bytes(rundir), placeholder),
               r.returncode, seconds)


def tree(root: Path) -> dict[str, Path]:
    return {str(p.relative_to(root)): p for p in sorted(root.rglob("*"))
            if p.is_file()}


def first_difference(ref: Path, cand: Path, sections: bool) -> str:
    """Where two text files first differ: the line, its dump section (with
    `sections`), and the two versions of it."""
    a = ref.read_text(encoding="utf-8", errors="replace").splitlines()
    b = cand.read_text(encoding="utf-8", errors="replace").splitlines()
    section = "?"
    for n, (x, y) in enumerate(zip(a, b), 1):
        if sections and x.startswith("["):
            section = x
        if x != y:
            where = f"line {n}, in {section}" if sections else f"line {n}"
            return f"{where}:\n    - {x[:300]}\n    + {y[:300]}"
    n = min(len(a), len(b)) + 1
    longer = "reference" if len(a) > len(b) else "candidate"
    return f"line {n}: only the {longer}'s file goes on"


def last_line(stderr: bytes) -> str:
    lines = stderr.decode(errors="replace").strip().splitlines()
    return lines[-1][:300] if lines else ""


def compare(ref_dir: Path, cand_dir: Path, ref: Run, cand: Run,
            rename: list[tuple[bytes, bytes]], mode: Mode) -> list[str]:
    """The differences between two runs, empty if none."""
    diffs: list[str] = []
    ref_out, ref_err = ref.stdout, ref.stderr
    for old, new in [*rename, *NORMALIZE]:
        ref_out = ref_out.replace(old, new)
        ref_err = ref_err.replace(old, new)
    if ref.exit != cand.exit:
        diffs.append(f"exit status {ref.exit} != {cand.exit}")
        if not mode.streams:
            diffs.append(f"reference stderr: {last_line(ref_err)}")
            diffs.append(f"candidate stderr: {last_line(cand.stderr)}")
    if mode.streams and ref_out != cand.stdout:
        diffs.append("stdout")
    if mode.streams and ref_err != cand.stderr:
        diffs.append("stderr")
    a = {rel: p for rel, p in tree(ref_dir).items() if mode.selected(rel)}
    b = {rel: p for rel, p in tree(cand_dir).items() if mode.selected(rel)}
    for rel in sorted(a.keys() - b.keys()):
        diffs.append(f"only in reference: {rel}")
    for rel in sorted(b.keys() - a.keys()):
        diffs.append(f"only in candidate: {rel}")
    for rel in sorted(a.keys() & b.keys()):
        if a[rel].read_bytes() != b[rel].read_bytes():
            diffs.append(f"differs: {rel}")
            if mode.dump_graph and rel == DUMP:
                diffs.append(first_difference(a[rel], b[rel], sections=True))
            elif mode.compare and rel.endswith(".proto"):
                diffs.append(first_difference(a[rel], b[rel], sections=False))
    return diffs


def run(work: Path, reference: list[str], candidate: list[str], jobs: int,
        only: str | None, rename: list[tuple[bytes, bytes]],
        mode: Mode, reference_instantiate: list[str] | None = None,
        candidate_instantiate: list[str] | None = None) -> int:
    all_cases = cases(work / "corpus")
    if mode.dump_graph:
        # Instances have no graph to dump.
        all_cases = [c for c in all_cases if c.tool == "reproto"]
    if only:
        all_cases = [c for c in all_cases if re.search(only, c.name)]
    runs = work / "runs"
    commands = {
        "reproto": (reference, candidate),
        "instantiate": (reference_instantiate or ["reproto-instantiate-schema"],
                        candidate_instantiate or [*candidate, "instantiate"]),
    }

    def one(case: Case) -> tuple[Case, list[str], Run, Run]:
        base = runs / case.name
        ref_cmd, cand_cmd = commands[case.tool]
        ref = run_side(ref_cmd, case, base / "reference", mode)
        cand = run_side(cand_cmd, case, base / "candidate", mode)
        diffs = compare(base / "reference", base / "candidate", ref, cand, rename,
                        mode)
        if not diffs:
            shutil.rmtree(base)
        return case, diffs, ref, cand

    results = []
    with concurrent.futures.ThreadPoolExecutor(jobs) as pool:
        for case, diffs, ref, cand in pool.map(one, all_cases):
            results.append((case, diffs, ref, cand))
            mark = "ok  " if not diffs else "DIFF"
            print(f"{mark} {case.name}", flush=True)

    failed = [(c, d) for c, d, _, _ in results if d]
    ref_time = sum(r.seconds for _, _, r, _ in results)
    cand_time = sum(c.seconds for _, _, _, c in results)
    # A case where both sides fail alike compares equal: list them, so that
    # a corpus that only exercises an error path does not pass unnoticed.
    errors = [(c, r.exit) for c, _, r, _ in results if r.exit != 0]
    lines = [f"{mode.label()}{len(results)} cases, {len(failed)} differ, "
             f"{len(errors)} where the reference exits with an error",
             f"reference: {shlex.join(reference)}, {ref_time:.1f} s in all",
             f"candidate: {shlex.join(candidate)}, {cand_time:.1f} s in all", ""]
    lines += [f"reference exit {code}: {c.name}" for c, code in errors]
    if errors:
        lines.append("")
    for case, diffs in failed:
        lines.append(f"{case.name}: {shlex.join(case.args)}")
        lines += [f"  {d}" for d in diffs[:20]]
        lines.append(f"  (runs kept in {runs / case.name})")
    report = "\n".join(lines) + "\n"
    (work / "report.txt").write_text(report)
    print("\n" + report, end="")
    return 1 if failed else 0


# --help compared by options and texts (spec 0424 S12): clap's layout is
# not Click's. Each option the reference shows must appear in the
# candidate's help with its text; the candidate shows no option of its own
# but these.
HELP_OWN = {"--help", "--version", "--jobs", "--fdp-plugin-cmd",
            "--move",         # spec 0445, protoback only
            "--report-out",   # spec 0446, protoback only
            "--export-used"}  # spec 0458, protoback only
# Click's built-ins, which clap words otherwise.
HELP_BUILTIN = {"--help", "--version"}


def click_options(text: str) -> list[tuple[list[str], str]]:
    """The options of a Click --help: their flags, and their text, the
    wrapped lines joined (a line ending in a hyphen joined without a
    space, as Click breaks a hyphenated word)."""
    entries: list[tuple[list[str], list[str]]] = []
    current: tuple[list[str], list[str]] | None = None
    for line in text.splitlines():
        m = re.match(r"^  (-\S.*?)(?:\s{2,}(\S.*))?$", line)
        if m:
            flags = [t for t in re.split(r"[ ,/]+", m.group(1)) if t.startswith("-")]
            current = (flags, [m.group(2)] if m.group(2) else [])
            entries.append(current)
        elif current is not None and line.startswith("    ") and line.strip():
            current[1].append(line.strip())
        else:
            current = None
    out = []
    for flags, parts in entries:
        text = ""
        for part in parts:
            text += part if not text or text.endswith("-") else " " + part
        out.append((flags, text))
    return out


def compare_help(reference: list[str], candidate: list[str]) -> list[str]:
    ref = subprocess.run([*reference, "--help"], capture_output=True, text=True).stdout
    cand = subprocess.run([*candidate, "--help"], capture_output=True, text=True).stdout
    flat = " ".join(cand.split())
    problems = []
    shown = set()
    for flags, text in click_options(ref):
        shown.update(flags)
        if set(flags) & HELP_BUILTIN:
            continue
        for f in flags:
            if not re.search(rf"(^|[\s,]){re.escape(f)}([\s,<=]|$)", flat):
                problems.append(f"{shlex.join(candidate)} --help: no {f}")
        if text and " ".join(text.split()) not in flat:
            problems.append(f"{shlex.join(candidate)} --help: {flags[-1]}'s text differs: "
                            f"{text[:80]!r}")
    for f in sorted(set(re.findall(r"(?:^|\s)(--[a-z0-9][a-z0-9-]*)", cand))):
        if f not in shown and f not in HELP_OWN:
            problems.append(f"{shlex.join(candidate)} --help: {f} is not the reference's")
    return problems


def main() -> int:
    parser = argparse.ArgumentParser(description=(__doc__ or "").split("\n")[0])
    sub = parser.add_subparsers(dest="command", required=True)
    p = sub.add_parser("prepare")
    p.add_argument("work", type=Path)
    p.add_argument("--googleapis", type=Path)
    p.add_argument("--otel", type=Path)
    r = sub.add_parser("run")
    r.add_argument("work", type=Path)
    r.add_argument("--reference", required=True)
    r.add_argument("--candidate", required=True)
    r.add_argument("--jobs", type=int, default=os.cpu_count() or 1)
    r.add_argument("--only")
    r.add_argument("--rename", action="append", default=[],
                   help="OLD=NEW: a phrase naming the reference's program, read as "
                   "the candidate's; repeatable, applied in order")
    r.add_argument("--dump-graph", action="store_true",
                   help="compare the graph dumps of phases 1 to 6 (spec 0428 S10)")
    r.add_argument("--reference-instantiate", default="reproto-instantiate-schema",
                   help="the reference's instance generator (spec 0432)")
    r.add_argument("--candidate-instantiate",
                   help="the candidate's instance generator; default: CANDIDATE "
                   "instantiate")
    r.add_argument("--compare", nargs="+", default=[], metavar="PATH",
                   help="compare only the exit status and the files under these "
                   "run-directory paths (spec 0429 S2)")
    hp = sub.add_parser("help", help="compare --help by options and texts (spec 0424 S12)")
    hp.add_argument("--reference", required=True)
    hp.add_argument("--candidate", required=True)
    hp.add_argument("--reference-instantiate", default="reproto-instantiate-schema")
    hp.add_argument("--candidate-instantiate")
    args = parser.parse_args()
    if args.command == "help":
        cand_inst = (shlex.split(args.candidate_instantiate) if args.candidate_instantiate
                     else [*shlex.split(args.candidate), "instantiate"])
        problems = (compare_help(shlex.split(args.reference), shlex.split(args.candidate))
                    + compare_help(shlex.split(args.reference_instantiate), cand_inst))
        print("\n".join(problems) if problems else "--help: the same options and texts")
        return 1 if problems else 0
    if args.command == "prepare":
        prepare(args.work.resolve(), args.googleapis, args.otel)
        return 0
    rename = []
    for r in args.rename:
        old, _, new = r.partition("=")
        rename.append((old.encode(), new.encode()))
    return run(args.work.resolve(), shlex.split(args.reference),
               shlex.split(args.candidate), args.jobs, args.only, rename,
               Mode(args.dump_graph, tuple(args.compare)),
               shlex.split(args.reference_instantiate),
               shlex.split(args.candidate_instantiate)
               if args.candidate_instantiate else None)


if __name__ == "__main__":
    sys.exit(main())
