#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Frederic Ruget <fred@atlant.is> (GitHub: @douzebis)
#
# SPDX-License-Identifier: MIT

# Publish the crates to crates.io in dependency order, skipping a crate
# already published at this version: if an upload fails halfway, running
# it again finishes the release (spec 0412 S1).
#
# Run from the repository root, in the release shell, after
# scripts/check-crates, with a crates.io token in CARGO_REGISTRY_TOKEN.
# .github/workflows/publish.yaml runs it with a short-lived token from
# crates.io trusted publishing.

set -euo pipefail

if [ ! -f Cargo.toml ] || [ ! -d scripts ]; then
    echo "publish-crates: run from the repository root" >&2
    exit 1
fi

source scripts/publishable-crates

pkgid=$(cargo pkgid -p prototext-core)
version=${pkgid##*[#@]}

# 0 if crate@version is on crates.io, 1 if not; fails on any other answer.
published() {
    local status
    status=$(curl --silent --output /dev/null --write-out '%{http_code}' \
        --user-agent "prototools publish-crates (https://github.com/douzebis/prototools)" \
        "https://crates.io/api/v1/crates/$1/$version")
    case "$status" in
        200) return 0 ;;
        404) return 1 ;;
        *)
            echo "publish-crates: crates.io answered $status for $1 $version" >&2
            exit 1
            ;;
    esac
}

# `check-crates` already built and verified the packages from this source
# and lock file, hence --no-verify.
for crate in "${crates[@]}"; do
    if published "$crate"; then
        echo "$crate $version is already on crates.io: skipped"
    else
        cargo publish -p "$crate" --locked --no-verify
    fi
done
