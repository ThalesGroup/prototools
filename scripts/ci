#!/usr/bin/env bash
# scripts/ci — the local full CI (spec 0485 S6): a preflight of cheap
# checks first, then nix.yml's Nix steps in nix.yml's order, stopping at
# the first failing step.
#
# Usage:
#   scripts/ci [--preflight] [--staging] [--target ci|ci-no-clippy]
#              [--max-jobs N] [--cores N]
#   scripts/ci --list-steps
#
#   --preflight   the preflight alone: what to run after an edit
#   --staging     also build the staged nixpkgs recipes, last
#   --target      the ci target (nix.yml's matrix.ci-target), default ci
#   --max-jobs, --cores   Nix's, default 2 and 6
#   --list-steps  print the Nix steps nix.yml must also run, in order, and
#                 exit: what the ci-workflow check compares (spec 0485 S7)
#
# Runs inside the repository's own dev shell, whose tools the preflight
# uses. The log goes to /tmp/<repo>-ci-<timestamp>.log, its path printed
# first, to follow with `tail -f`.
set -uo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)

# nix.yml's steps, as nix.yml spells them (CI_TARGET for its
# ${{ matrix.ci-target }}): the ci-workflow check compares this list with
# nix.yml's, so a step added to one must be added to the other.
nix_steps() {
  cat <<'STEPS'
nix-instantiate -A CI_TARGET --option allow-import-from-derivation false > /dev/null
scripts/protobuf-release-check
nix-build -A rust-fmt
nix-build -A CI_TARGET
nix-build -A pypi
nix-build -A crates-io
STEPS
}

preflight_only=0 staging=0 target=ci max_jobs=2 cores=6
while [ $# -gt 0 ]; do
  case $1 in
    --preflight)  preflight_only=1 ;;
    --staging)    staging=1 ;;
    --target)     target=${2:?--target needs a value}; shift ;;
    --max-jobs)   max_jobs=${2:?--max-jobs needs a value}; shift ;;
    --cores)      cores=${2:?--cores needs a value}; shift ;;
    --list-steps) nix_steps; exit 0 ;;
    -h|--help)    sed -n '2,/^set -uo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
    *) echo "scripts/ci: unknown argument $1 (see --help)" >&2; exit 2 ;;
  esac
  shift
done

if [ "${NIXSHELL_REPO:-}" != "$repo" ]; then
  echo "scripts/ci: run it inside this repository's dev shell, whose tools it uses:" >&2
  echo "  cd $repo && nix-shell" >&2
  exit 2
fi

# Its builds have their bounds (--max-jobs, --cores): no hint how to bound
# them (spec 0489 S2).
export PROTOTOOLS_QUIET=1

log=/tmp/$(basename "$repo")-ci-$(date +%Y%m%d-%H%M%S).log
echo "scripts/ci: log $log"
exec > >(tee "$log") 2>&1

cd "$repo"
start=$SECONDS

# One step: its name, then its command. Checked on its own exit status,
# not through `set -e` across a pipe (spec 0485 S6, the 0487 incident).
step() {
  local name=$1 t=$SECONDS
  shift
  echo "== $name"
  if "$@"; then
    echo "== $name: ok ($((SECONDS - t)) s)"
  else
    echo "== $name: FAILED"
    echo "scripts/ci: stopped at '$name' after $((SECONDS - start)) s; log $log"
    exit 1
  fi
}

# One of nix_steps' lines, run: CI_TARGET is the target, and a nix-build
# takes the build limits and no out-link.
nix_step() {
  local cmd=${1//CI_TARGET/$target}
  case $cmd in
    nix-build*) cmd="$cmd --max-jobs $max_jobs --cores $cores --no-out-link" ;;
  esac
  step "$cmd" sh -c "$cmd"
}

mapfile -t steps < <(nix_steps)

# ── Preflight: about a minute, no Nix build of the workspace ─────────────
# The local checks, which a ci member or a workflow step runs much later,
# then nix.yml's own cheap steps: those before its first nix-build.
step "cargo fmt" cargo fmt --all -- --check
# The repository's Python, as pythonRuff lints it: attic/ and docs/ left out.
step "ruff" sh -c 'ruff check --no-cache $(git ls-files "*.py" | grep -vE "^(attic|docs)/")'
step "nixfmt (staged recipes)" sh -c 'nixfmt --check $(git ls-files "nixpkgs/pkgs/*.nix")'
step "reuse lint" sh -c 'reuse lint > /dev/null || reuse lint'
i=0
while [ $i -lt ${#steps[@]} ] && [[ ${steps[$i]} != nix-build* ]]; do
  nix_step "${steps[$i]}"
  i=$((i + 1))
done
if [ "$preflight_only" = 1 ]; then
  echo "== preflight passed ($((SECONDS - start)) s)"
  exit 0
fi

# ── Full run: nix.yml's remaining steps, in its order ────────────────────
while [ $i -lt ${#steps[@]} ]; do
  nix_step "${steps[$i]}"
  i=$((i + 1))
done
if [ "$staging" = 1 ]; then
  nix_step "nix-build -A nixpkgs-staging"
fi
echo "== CI PASSED ($((SECONDS - start)) s)"
