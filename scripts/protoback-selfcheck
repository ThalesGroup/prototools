#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Frederic Ruget <fred@atlant.is> (GitHub: @douzebis)
#
# SPDX-License-Identifier: MIT

# The differential harness, both modes, protoback against protoback: the
# candidate (this tree's build) against the binary built at REF, a commit
# already checked against reproto. Seconds where reproto takes minutes,
# and stricter: byte for byte against the last validated protoback.
#
# Usage: scripts/protoback-selfcheck WORK [REF] [HARNESS-RUN-OPTION...]
#   WORK  a harness work directory, its corpus prepared
#         (scripts/protoback-harness prepare WORK)
#   REF   the reference commit: HEAD (the default) for the changes not
#         yet committed; the parent of a commit to check that commit
#
# For what must not change protoback's output: a speed-up, a refactor, a
# protoback-only feature behind a flag (run without the flag). A change in
# what both tools output still needs the harness against reproto, which
# must agree with protoback.
#
# The reference is built with --profile quick in a worktree of its own,
# in its own target directory, and kept under
# ${PROTOBACK_REF_CACHE:-~/.cache/protoback-ref}/<sha>: built once per
# commit. Its target directory stays there (about 600 MB), so that the
# next reference builds incrementally; remove the cache to reclaim it.
# The candidate is target/quick/protoback, built first.
set -euo pipefail

work=${1:?usage: scripts/protoback-selfcheck WORK [REF] [HARNESS-RUN-OPTION...]}
ref=${2:-HEAD}
shift $(( $# >= 2 ? 2 : 1 ))
repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cache=${PROTOBACK_REF_CACHE:-$HOME/.cache/protoback-ref}
sha=$(git -C "$repo" rev-parse --verify "$ref^{commit}")
reference=$cache/$sha/protoback

if [[ ! -x $reference ]]; then
    echo "selfcheck: building the reference at ${sha:0:8}" >&2
    mkdir -p "$cache"
    tree=$cache/worktree
    git -C "$repo" worktree remove --force "$tree" 2>/dev/null || true
    git -C "$repo" worktree add --detach --quiet "$tree" "$sha"
    trap 'git -C "$repo" worktree remove --force "$tree" 2>/dev/null || true' EXIT
    CARGO_TARGET_DIR=$cache/target cargo build --quiet --profile quick \
        --manifest-path "$tree/Cargo.toml" -p protoback
    mkdir -p "$cache/$sha"
    cp "$cache/target/quick/protoback" "$reference"
fi

echo "selfcheck: building the candidate" >&2
cargo build --quiet --profile quick --manifest-path "$repo/Cargo.toml" -p protoback
candidate=$repo/target/quick/protoback

harness=$repo/scripts/protoback-harness
status=0
for mode in "" --dump-graph; do
    rm -rf "$work/runs"
    python3 -B "$harness" run "$work" $mode \
        --reference "$reference" --reference-instantiate "$reference instantiate" \
        --candidate "$candidate" --candidate-instantiate "$candidate instantiate" \
        "$@" || status=1
done
rm -rf "$work/runs"
exit $status
